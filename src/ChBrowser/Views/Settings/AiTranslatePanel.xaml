<UserControl x:Class="ChBrowser.Views.Settings.AiTranslatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ChBrowser.ViewModels"
             xmlns:conv="clr-namespace:ChBrowser.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <!-- 「AI翻訳」カテゴリ: スレ / レスの翻訳に使う LLM プロファイル (プロファイルは「LLM」カテゴリで登録)。 -->
    <UserControl.Resources>
        <conv:LlmStatusToBrushConverter x:Key="LlmStatusBrush" />

        <!-- フォーム行ラベル共通スタイル -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="AI翻訳" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,8">
            スレ表示のツールバーの 🌐 (スレ全体) と、レス番号 (▸) メニューの「このレスを翻訳」で使う AI モデルです。
            日本語に翻訳します。使う LLM プロファイルを選びます (プロファイルは「LLM」カテゴリで登録)。
        </TextBlock>
        <StackPanel Width="340" HorizontalAlignment="Left">
            <TextBlock Text="使う LLM プロファイル" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding LlmProfileChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectedValue="{Binding TranslateLlmProfileId, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,6" />
            <TextBlock Text="同時実行数 (並列リクエスト本数)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <TextBox Text="{Binding TranslateConcurrency, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}"
                     Width="120" HorizontalAlignment="Left"
                     ToolTip="翻訳のリクエストを何本並行で投げるか (全スレ合計、既定 2)。" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,2,0,0"
                       Text="※ サーバを --parallel この値以上で起動しないと並列化の効果は出ません (1〜16)。" />

            <CheckBox Content="リーズニングOFFオプションを付加する" Margin="0,10,0,0"
                      IsChecked="{Binding TranslateDisableReasoning, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,2,0,0"
                       Text="リーズニングが動くと翻訳が遅くなるため、リーズニングを OFF にするための一般的な設定を付加します。" />

        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#A07020" FontSize="11" Margin="0,8,0,0">
            ※ 翻訳したレスはスレのログの隣 (.tr.json) に保存され、同じレスを何度も送りません。
        </TextBlock>

    </StackPanel>
</UserControl>
