<UserControl x:Class="ChBrowser.Views.Settings.LlmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ChBrowser.ViewModels"
             xmlns:conv="clr-namespace:ChBrowser.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <!-- 「LLM」カテゴリ: LLM の接続プロファイルを名前付きで複数登録する。AI チャット / NG 判定 AI / AI 翻訳 はここから選ぶ。 -->
    <UserControl.Resources>
        <conv:LlmStatusToBrushConverter x:Key="LlmStatusBrush" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="LLM プロファイル" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,10">
            OpenAI 互換 API (OpenAI 本体のほか LM Studio / Ollama / vLLM / llama.cpp 等のローカル LLM サーバ) の接続先を、名前を付けて登録します。
            AI チャット・NG 判定 AI・AI 翻訳は、それぞれのカテゴリで使うプロファイルを選びます (既定はデフォルトのプロファイル)。
        </TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左: 一覧と追加 / 削除 / デフォルト -->
            <StackPanel Grid.Column="0">
                <ListBox ItemsSource="{Binding LlmProfiles}"
                         SelectedItem="{Binding SelectedLlmProfile, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName"
                         Height="220" />
                <TextBlock Text="★ = デフォルトのプロファイル" Foreground="#888" FontSize="11" Margin="0,2,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="追加" Padding="10,2" Margin="0,0,6,0" Command="{Binding AddLlmProfileCommand}" />
                    <Button Content="削除" Padding="10,2" Margin="0,0,6,0" Command="{Binding RemoveLlmProfileCommand}"
                            ToolTip="選択中のプロファイルを削除します (使っていたカテゴリはデフォルトのプロファイルを使うように戻ります)" />
                </StackPanel>
                <Button Content="デフォルトにする" Padding="10,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding SetDefaultLlmProfileCommand}"
                        ToolTip="選択中のプロファイルをデフォルトにします (「デフォルトのプロファイルを使う」カテゴリが使います)" />
            </StackPanel>

            <!-- 右: 選択中のプロファイルの編集 -->
            <StackPanel Grid.Column="2" DataContext="{Binding SelectedLlmProfile}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="名前" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" Margin="0,0,0,6" />
                <TextBlock Text="API URL" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" Margin="0,0,0,6" />
                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ApiKeyInput" PasswordChanged="ApiKeyInput_PasswordChanged" Margin="0,0,0,6" />
                <TextBlock Text="モデル名 (例: gpt-4o-mini)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" Margin="0,0,0,6" />
                <TextBlock Text="Context Size (トークン数)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}"
                         Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <CheckBox Content="画像を入力できる" IsChecked="{Binding SupportsImages, Mode=TwoWay}"
                          ToolTip="画像 (ビジョン) の入力に対応したモデルなら ON にします" />

                <Button Content="接続確認" Padding="14,3" HorizontalAlignment="Left" Margin="0,12,0,4"
                        Command="{Binding DataContext.TestLlmProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTip="このプロファイルの設定で OpenAI 互換 API に接続できるか確認します" />
                <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{Binding ConnectionStatus, Converter={StaticResource LlmStatusBrush}}" />
            </StackPanel>
        </Grid>

        <TextBlock TextWrapping="Wrap" Foreground="#A07020" FontSize="11" Margin="0,12,0,0">
            ※ API キーは config.json に平文で保存されます。
        </TextBlock>
    </StackPanel>
</UserControl>
