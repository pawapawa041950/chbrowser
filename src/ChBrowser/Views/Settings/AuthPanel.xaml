<UserControl x:Class="ChBrowser.Views.Settings.AuthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ChBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <StackPanel>

        <TextBlock Text="どんぐり (5ch) メール認証" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,12">
            メールアドレスを設定するとアプリ起動時に自動でログインを試行します。
            ログイン状態はメインウィンドウのステータスバーに表示されます。
        </TextBlock>

        <!-- メアド (TextBox はバインド可) -->
        <TextBlock Text="メールアドレス" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Text="{Binding DonguriEmail, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}"
                 Width="320"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <!-- パスワード (PasswordBox は SecurityException 回避で Password 直接バインド不可、code-behind で連携) -->
        <TextBlock Text="パスワード" FontWeight="SemiBold" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput"
                     Width="320"
                     HorizontalAlignment="Left"
                     PasswordChanged="PasswordInput_PasswordChanged"
                     Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="#A07020" FontSize="11"
                   Margin="0,0,0,16">
            ※ パスワードは現在 config.json に平文で保存されます (= ファイル盗難で第三者に読まれ得る)。
            機密性の高いアカウントの再利用は避けてください。
        </TextBlock>

        <!-- ログイン状態 + 手動ログインボタン -->
        <TextBlock Text="ログイン状態" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel HorizontalAlignment="Left" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="今すぐログイン"
                    Padding="10,4"
                    Margin="8,0,0,0"
                    Command="{Binding LoginNowCommand}"
                    ToolTip="入力中の値を保存して、すぐにログイン試行する" />
            <Border Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="1" Padding="10,6"
                    MinWidth="320">
                <TextBlock Text="{Binding DonguriLoginStatus}" TextWrapping="Wrap" />
            </Border>
        </DockPanel>

        <!-- エッヂ掲示板 (bbs.eddibb.cc) の認証。初回投稿で発行される Cookie (edge-token) をアプリが
             data/eddibb.cc/cookies.txt に保存し、ユーザがブラウザの認証ページで認証コードを入力すると以降はその Cookie で書ける。 -->
        <Separator Margin="0,4,0,12" />
        <TextBlock Text="エッヂ掲示板 (bbs.eddibb.cc) の認証" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,12">
            初回の書き込みはエラーになり、6 桁の認証コードが表示されます。同時に発行される Cookie (edge-token) は
            アプリが data/eddibb.cc/cookies.txt に保存します。書き込みダイアログの「認証ページを開く」から
            ブラウザで認証コードを入力すると、以降はその Cookie で書き込めます。認証は書き込んだ環境 (IP アドレス) に紐づきます。
        </TextBlock>

        <TextBlock Text="認証トークン (任意)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,4">
            認証ページの完了画面に表示されるトークンを入れると、Cookie が無いときにメール欄へ「#トークン」を付けて送ります。
            通常は空欄のままで構いません (Cookie があればトークンは送りません)。
        </TextBlock>
        <TextBox Text="{Binding EddiAuthToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}"
                 Width="420"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <TextBlock Text="Cookie" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,8">
            エッヂ掲示板から受け取った Cookie (edge-token / tinker-token) を削除します。次の書き込みでは再び認証コードによる認証が必要になります。
        </TextBlock>
        <Button Content="エッヂの Cookie を削除"
                Width="180"
                HorizontalAlignment="Left"
                Padding="8,4"
                Margin="0,0,0,12"
                Command="{Binding ClearEddiCookiesCommand}" />

        <!-- reddit: アプリ内ブラウザ (WebView2 の reddit 用プロファイル) でログインし、そのセッションで読み書きする。
             doc/reddit-design.md §5。ログインの Cookie は exe の隣の ChBrowser.exe.WebView2 フォルダに保存され、再起動後も残る。 -->
        <Separator Margin="0,4,0,12" />
        <TextBlock Text="reddit" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,8">
            reddit は閲覧にもログインが必要です。「ログイン」でアプリ内のブラウザ窓が開くので、reddit のページでログインしてください
            (パスワード等はアプリには渡りません)。ログイン状態はアプリ内ブラウザに保存され、次回起動後もそのまま使えます。
            ログインが切れた場合は、reddit を開いたときに自動でログイン窓が開きます。
        </TextBlock>
        <TextBlock TextWrapping="Wrap"
                   Foreground="#A07020" FontSize="11"
                   Margin="0,0,0,8">
            ※ 公式 API の登録ではなく、ログイン済みブラウザと同じ経路で通信します。要求は 1 秒以上の間隔を空けて送りますが、
            reddit 側で自動アクセスと判断されるとアカウントが制限される可能性はゼロではありません。
        </TextBlock>

        <TextBlock Text="ログイン状態" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="ログアウト" Padding="10,4" Margin="8,0,0,0"
                    Command="{Binding RedditLogoutCommand}" />
            <Button DockPanel.Dock="Right" Content="ログイン" Padding="10,4" Margin="8,0,0,0"
                    Command="{Binding RedditLoginCommand}" />
            <Border Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="1" Padding="10,6" MinWidth="320">
                <TextBlock Text="{Binding RedditLoginStatus}" TextWrapping="Wrap" />
            </Border>
        </DockPanel>

        <TextBlock Text="接続テスト" FontWeight="SemiBold" Margin="0,4,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,4">
            ログイン状態・一覧・スレ・続き (more)・購読一覧などを実際に取得して、応答の状態を確かめます
            (結果は data/reddit.com/probe.txt にも保存されます)。
        </TextBlock>
        <Button Content="接続テスト" Width="120" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6"
                Command="{Binding RedditProbeCommand}" />
        <TextBox Text="{Binding RedditProbeResult, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, MS Gothic"
                 FontSize="11"
                 MinHeight="60"
                 MaxHeight="260"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12" />

    </StackPanel>
</UserControl>
