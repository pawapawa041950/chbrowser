<UserControl x:Class="ChBrowser.Views.Settings.ThumbnailRulesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ChBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <!-- 「サムネイルルール」カテゴリ: 画像・動画そのものではないページの URL (x.com の投稿、imgur のアルバム等) から
         サムネイルを出すためのルールの一覧・編集・テスト。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New'" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
            画像や動画そのものではないページの URL (x.com の投稿、pixiv の作品、imgur のアルバム、YouTube 等) から、サムネイルや動画プレーヤーを出すためのルールです。
            URL が「対象 URL」に一致すると、そのルールの手順で画像・動画の URL を求めます。上から順に試し、最初に一致したルール 1 つだけを使います。
            変更はすぐ保存されます (開いているスレは、開き直すか更新した分から反映されます)。
        </TextBlock>
        <TextBlock Text="{Binding ThumbnailRulesFileError}" Foreground="#C00" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ThumbnailRulesFileError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: 一覧と追加 / 削除 / 並べ替え -->
            <StackPanel Grid.Column="0">
                <ListBox ItemsSource="{Binding ThumbnailRules}"
                         SelectedItem="{Binding SelectedThumbnailRule, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName"
                         Height="230" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="追加" Padding="8,2" Margin="0,0,6,0" Command="{Binding AddThumbnailRuleCommand}" />
                    <Button Content="削除" Padding="8,2" Margin="0,0,6,0" Command="{Binding RemoveThumbnailRuleCommand}"
                            ToolTip="選択中のルールを削除します (既定のルールを置き換えていた場合は既定に戻ります)" />
                    <Button Content="上へ" Padding="8,2" Margin="0,0,6,0" Command="{Binding MoveThumbnailRuleUpCommand}" />
                    <Button Content="下へ" Padding="8,2" Command="{Binding MoveThumbnailRuleDownCommand}" />
                </StackPanel>
                <Button Content="この既定のルールを編集する" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding EditBuiltinThumbnailRuleCommand}"
                        ToolTip="選択中の既定のルールを写し取って、編集できるようにします (止めたいときは写し取ってから「有効」を外します)" />
                <Button Content="保存先のフォルダを開く" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenThumbnailRulesFolderCommand}"
                        ToolTip="追加・編集したルールは thumbnail_rules.csv に保存されます" />
            </StackPanel>

            <!-- 右: 選択中のルール -->
            <StackPanel Grid.Column="2" DataContext="{Binding SelectedThumbnailRule}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource Hint}" Foreground="#A07020" Margin="0,0,0,6"
                           Text="既定のルールです (見るだけ)。変えたいときは左の「この既定のルールを編集する」を押してください。"
                           Visibility="{Binding IsBuiltin, Converter={StaticResource BoolToVis}}" />

                <!-- 既定のルールは見るだけ: 文字の欄は読み取り専用 (長い式を横に送って読める・写せる)、選ぶ欄は無効にする -->
                <StackPanel>
                    <CheckBox Content="有効" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Margin="0,0,0,6" />

                    <TextBlock Text="名前" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Margin="0,0,0,6" />

                    <TextBlock Text="対象 URL (正規表現。(?&lt;id&gt;…) のように名前を付けた部分を、下の欄で {id} として使えます)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Match, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Style="{StaticResource CodeBox}" />

                    <TextBlock Text="種類" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:ThumbnailRuleItem.Kinds}"
                              SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding Kind, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                              HorizontalAlignment="Left" Width="280" Margin="0,0,0,6" />

                    <TextBlock Text="表示のしかた" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:ThumbnailRuleItem.Displays}"
                              SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding Display, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                              HorizontalAlignment="Left" Width="400" Margin="0,0,0,6"
                              ToolTip="このアプリで再生できない動画のページ (YouTube 等) は「外部サイトへ誘導」にして、取り出す URL をサムネイル画像にします" />

                    <!-- URL を組み立てるだけ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetch}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="組み立てる画像の URL (例: https://example.com/img/{id}.jpg)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Result, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Style="{StaticResource CodeBox}" />
                    </StackPanel>

                    <!-- 取得して取り出す -->
                    <StackPanel Visibility="{Binding IsFetch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="取得先の URL (例: https://example.com/api/{id})" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FetchUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Style="{StaticResource CodeBox}" />

                        <TextBlock Text="取得時に付けるヘッダー (1 行に 1 つ。例: Referer: https://example.com/)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Style="{StaticResource CodeBox}"
                                 AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="取り出し方 (1 行に 1 候補。上から試し、取れた最初の候補を使います)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ExtractText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=400}" IsReadOnly="{Binding IsBuiltin}" Style="{StaticResource CodeBox}"
                                 AcceptsReturn="True" Height="52" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="JSON: 項目の場所を書きます。「.」で下の階層、「[]」で配列の全要素、「[0]」で 1 つ目、「a|b」は a が無ければ b。例: media[].url&#x0a;正規表現: かっこ ( ) で囲んだ 1 つ目の部分が URL になります。例: &lt;meta property=&quot;og:image&quot; content=&quot;([^&quot;]+)&quot;" />

                        <CheckBox Content="何も取れなかったら「画像なし」として、サムネイルの枠を出さない"
                                  IsChecked="{Binding EmptyMeansNoMedia, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                                  ToolTip="OFF のときは「画像取得失敗 — クリックで再試行」の枠を出します (ログインが要るページ等、後で取れるかもしれない場合向け)" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Error}" Foreground="#C00" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- テスト -->
        <TextBlock Text="URL を入れて試す" FontWeight="SemiBold" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="試す" Padding="14,2" Margin="6,0,0,0" Command="{Binding TestThumbnailRuleCommand}" IsDefault="False" />
            <TextBox Text="{Binding ThumbnailTestUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontFamily="Consolas, 'Courier New'" />
        </DockPanel>
        <TextBox Text="{Binding ThumbnailTestResult, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, 'Courier New'" FontSize="11"
                 Height="120" Margin="0,6,0,0" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFAFA" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Text="いまの (編集中の) ルールで、その URL からどの画像の URL が取り出せるかを確かめます。スレでは 1 つの URL につき 4 枚までサムネイルを出し、残りは「他 N 枚」と表示します。" />
    </StackPanel>
</UserControl>
