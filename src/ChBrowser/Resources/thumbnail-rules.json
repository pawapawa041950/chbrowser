{
  // サムネイルの取得ルール (既定)。画像・動画そのものではないページの URL から、サムネイルにする画像の URL を求める。
  // 利用者のルールは data/app/thumbnail_rules.json に同じ形式で書く (同じ name のルールはこの既定を置き換える。
  // "enabled": false で既定を止められる)。利用者のルールが先に試され、最初に match したルール 1 つだけが使われる。
  //
  //   name     ルールの名前 (置き換え・ログ用)
  //   match    対象 URL の正規表現 (大文字小文字は区別しない)。名前付きグループ (?<id>…) を下の {id} で使える。
  //            アプリ (.NET) と表示側 (JavaScript) の両方で使うので、どちらでも通る書き方にする
  //   result   取得せずに URL を組み立てるだけのとき、その URL (例 "https://example.com/img/{id}.jpg")。fetch より優先
  //   fetch    取得するとき: url (組み立てる URL)、headers (付けるヘッダー。Referer 等)
  //   format   取得した内容の読み方: "json" (既定) か "regex" (HTML 等の文字列)
  //   extract  取り出し方の候補。上から試し、1 件以上取れた最初の候補を使う。
  //            json : 項目の場所。"." で下の階層、"[]" で配列の全要素、"[0]" で配列の 1 要素、"a|b" は a が無ければ b
  //            regex: 正規表現。グループ 1 (無ければ一致した全体) が URL。一致した数だけ取り出す
  //   empty    何も取れなかったときの扱い: "unavailable" (既定。「取得失敗 — クリックで再試行」) か
  //            "noMedia" (画像が無いと確定。サムネイルの枠を出さない)
  //
  // 取り出した URL が動画 (.mp4 等) なら動画のサムネイルになる。複数取れたら複数のサムネイルを出す。
  "rules": [
    {
      // x.com (Twitter): fxtwitter の公開 JSON。写真は url、動画 / GIF はサムネイル画像 (thumbnail_url)。
      // 本文側に無ければ引用元 (quote) のメディア。どちらにも無ければ文字だけの投稿
      "name": "x.com",
      "match": "^https?://(?:www\\.|m\\.|mobile\\.)?(?:twitter|x|fxtwitter|vxtwitter)\\.com/[A-Za-z0-9_]+/status/(?<id>\\d+)",
      "fetch": { "url": "https://api.fxtwitter.com/i/status/{id}", "headers": { "Accept": "application/json" } },
      "format": "json",
      "extract": [
        "tweet.media.all[].thumbnail_url|url",
        "tweet.quote.media.all[].thumbnail_url|url"
      ],
      "empty": "noMedia"
    },
    {
      // pixiv: 作品の全ページ。R-18・非公開はログインが要るので取れない (取得失敗の扱い)。
      // 画像 (i.pximg.net) の取得に要る Referer はアプリが別に付けている
      "name": "pixiv",
      "match": "^https?://(?:www\\.)?pixiv\\.net/(?:en/)?artworks/(?<id>\\d+)",
      "fetch": {
        "url": "https://www.pixiv.net/ajax/illust/{id}/pages",
        "headers": { "Accept": "application/json", "Referer": "https://www.pixiv.net/" }
      },
      "format": "json",
      "extract": [ "body[].urls.regular|original|small" ]
    },
    {
      // imgur のアルバム (imgur.com/a/<id>、imgur.com/a/<題名>-<id>): アルバム内の全画像・動画。
      // client_id は imgur 自身のサイト用のもの (使えなくなったら利用者のルールで差し替える)
      "name": "imgur-album",
      "match": "^https?://(?:www\\.|m\\.)?imgur\\.com/a/(?:[^/?#]*-)?(?<id>[A-Za-z0-9]+)(?:[/?#].*)?$",
      "fetch": {
        "url": "https://api.imgur.com/post/v1/albums/{id}?client_id=546c25a59c58ad7&include=media",
        "headers": { "Accept": "application/json" }
      },
      "format": "json",
      "extract": [ "media[].url" ]
    }
  ]
}
